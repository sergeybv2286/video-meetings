# Postgres (docker-compose.yml). Скопируйте в .env, чтобы переопределить значения по умолчанию.
POSTGRES_USER=video_meetings
POSTGRES_PASSWORD=video_meetings
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# API (apps/api). Если не задано — используется строка подключения ниже (совпадает со значениями по умолчанию для Postgres выше).
# DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings
# JWT_SECRET=   # в production обязателен (≥32 символов); вне production есть значение по умолчанию
# RATE_LIMIT=300   # запросов с одного IP в минуту, общий лимит
# AUTH_RATE_LIMIT=10   # в минуту: вход, регистрация, смена и проверка пароля
# USER_FILES_QUOTA=5368709120   # квота файлов встреч на пользователя в байтах, по умолчанию 5 ГБ
# FILES_STORAGE_DIR=./storage   # каталог файлов встреч (относительно apps/api), по умолчанию ./storage
# AVATARS_STORAGE_DIR=./storage/avatars   # каталог аватаров пользователей (относительно apps/api), по умолчанию ./storage/avatars
# MEETING_FILE_MAX_SIZE=524288000   # лимит размера файла встречи в байтах, по умолчанию 500 МБ
# PORT=3001   # порт API, по умолчанию 3001
# WEB_ORIGIN=http://localhost:3000   # origin web для CORS, по умолчанию http://localhost:3000
# Транскрибация MP3/MP4 (локальный Whisper + ffmpeg, без внешних сетевых вызовов; нужны установленные openai-whisper и ffmpeg)
# WHISPER_COMMAND=whisper   # команда запуска Whisper, по умолчанию whisper
# FFMPEG_COMMAND=ffmpeg   # команда запуска ffmpeg, по умолчанию ffmpeg
# WHISPER_MODEL=base   # модель Whisper, по умолчанию base
# WHISPER_MODEL_DIR=   # каталог со скачанной моделью (чтобы Whisper не лез в сеть); по умолчанию кэш Whisper
# TRANSCRIPTION_TIMEOUT_MS=7200000   # максимальный срок обработки одного файла, мс; по умолчанию 2 часа
# TRANSCRIPTION_RETRY_RATE_LIMIT=5   # повторов транскрибации в минуту (дополнительно к RATE_LIMIT), по умолчанию 5
