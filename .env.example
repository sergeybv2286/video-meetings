# Postgres (docker-compose.yml). Скопируйте в .env, чтобы переопределить значения по умолчанию.
POSTGRES_USER=video_meetings
POSTGRES_PASSWORD=video_meetings
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# API (apps/api). Если не задано — используется строка подключения ниже (совпадает со значениями по умолчанию для Postgres выше).
# DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings
# JWT_SECRET=
# FILES_STORAGE_DIR=./storage   # каталог файлов встреч (относительно apps/api), по умолчанию ./storage
# AVATARS_STORAGE_DIR=./storage/avatars   # каталог аватаров пользователей (относительно apps/api), по умолчанию ./storage/avatars
# MEETING_FILE_MAX_SIZE=524288000   # лимит размера файла встречи в байтах, по умолчанию 500 МБ
# PORT=3001   # порт API, по умолчанию 3001
# WEB_ORIGIN=http://localhost:3000   # origin web для CORS, по умолчанию http://localhost:3000
